---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemsMap from '../components/SystemsMap.astro';
import Ledger from '../components/Ledger.astro';
import Contact from '../components/Contact.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { site } from '../site';

const professional = (await getCollection('work', (e) => ['experience', 'product', 'client'].includes(e.data.kind))).sort(
  (a, b) => a.data.order - b.data.order,
);

const protocol = [
  { title: 'Map', body: 'Sit with the people who will use it and write down how the work really runs.' },
  { title: 'Build', body: 'Ship a working slice fast, then grow it with your team watching.' },
  { title: 'Harden', body: 'Tests, roles, backups and security checks before real data goes in.' },
  { title: 'Hand over', body: 'Docs, training and a system your staff can run without me.' },
];

const skills = [
  'Python',
  'TypeScript',
  'JavaScript',
  'React',
  'Next.js',
  'PostgreSQL',
  'SQL',
  'REST APIs',
  'Docker',
  'Git & GitHub Actions',
  'Odoo ERP',
];
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="status-pill"><span class="pulse" aria-hidden="true"></span>Open for projects &amp; roles</span>
        <h1>I build software for <span class="mark">real operations.</span></h1>
        <p class="lead">
          Gym front desks, car showrooms, multi-company ERPs, business messaging. I build the web systems businesses run on
          every day, from the database to the screen.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/services/">Work with me →</a>
          <a class="btn" href="/cv.pdf">Download CV</a>
        </div>
        <div class="id-line">
          <Image src={portrait} alt={`Portrait of ${site.name}`} width={112} height={112} loading="eager" />
          <div>
            <b>{site.name}</b>
            <span>{site.role} · {site.location}</span>
          </div>
        </div>
      </div>
      <SystemsMap work={professional} />
    </div>
  </section>

  <section class="section ruled" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <span class="label"><span class="n">§01</span>The ledger</span>
        <h2 id="work-title">Systems in the field.</h2>
        <a class="link-arrow" href="/work/">All projects →</a>
      </div>
      <Ledger work={professional} />
    </div>
  </section>

  <section class="section ruled" aria-labelledby="protocol-title">
    <div class="container">
      <div class="section-head">
        <span class="label"><span class="n">§02</span>Protocol</span>
        <h2 id="protocol-title">How a build runs.</h2>
        <a class="link-arrow" href="/workflow/">My process →</a>
      </div>
      <ol class="protocol">
        {
          protocol.map((s, i) => (
            <li>
              <span class="step">STEP {String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section ruled" id="experience" aria-labelledby="exp-title">
    <div class="container split">
      <div>
        <span class="label"><span class="n">§03</span>Record</span>
        <h2 id="exp-title" class="page-title">Experience &amp; education.</h2>
        <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
        <p class="muted page-actions">I have also worked with Java, C# and C++ in coursework.</p>
      </div>
      <ol class="cv">
        <li>
          <span class="when">Sep – Oct 2026</span>
          <span>
            <a href="/work/erp-cleanup/">ERP audit &amp; data-quality trainee</a>
            <span class="where"> · Brimat Ventures Group.</span> Industrial attachment. Audited and cleaned one Odoo 19 system
            shared by four companies: customers, a 6,600-item catalogue, supplier bills and stock receiving.
          </span>
        </li>
        <li>
          <span class="when">2026 – present</span>
          <span>
            Independent developer<span class="where"> · </span>Built <a href="/work/gymflow/">GymFlow</a> end to end, a
            <a href="/work/dealership/">dealership platform</a> for a client, and <a href="/work/fanovo/">Fanovo</a>.
          </span>
        </li>
        <li>
          <span class="when">March 2027</span>
          <span>BSc Software Development<span class="where"> · KCA University.</span> Coursework complete.</span>
        </li>
      </ol>
    </div>
  </section>

  <Contact />
</Base>
