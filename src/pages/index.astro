---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Contact from '../components/Contact.astro';
import { site } from '../site';

const featured = (await getCollection('work', (e) => e.data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const skills = ['Python', 'TypeScript', 'JavaScript', 'React', 'Next.js', 'PostgreSQL', 'SQL', 'REST APIs', 'Docker', 'Git & GitHub Actions', 'Odoo ERP'];
---
<Base>
  <div class="wrap hero">
    <div>
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>I build software for <em>real operations.</em></h1>
      <p class="lead">I'm <strong>{site.name}</strong>. I build the web systems businesses run on every day, from the database to the screen.</p>
      <p class="availability">{site.availability}</p>
      <div class="actions">
        <a class="button primary" href="#work">See my work ↓</a>
        <a class="button" href="/cv.pdf">Download CV</a>
      </div>
    </div>
    <div class="portrait">
      <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="960" height="960" fetchpriority="high" />
    </div>
  </div>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-title">Selected work</h2>
        <p>A product I own, a client build, and ERP work from my attachment.</p>
      </div>
      <div class="cards">
        {featured.map((entry) => <WorkCard entry={entry} />)}
      </div>
      <p class="see-all"><a class="button" href="/work/">All projects →</a></p>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="wrap two-col">
      <div>
        <h2 id="exp-title">Experience &amp; education</h2>
        <ol class="timeline">
          <li>
            <time>Sep – Oct 2026</time>
            <h3>ERP audit &amp; data-quality trainee · Brimat Ventures Group</h3>
            <p>Industrial attachment. Audited and cleaned one Odoo 19 system shared by four companies: customers, a 6,600-item catalogue, supplier bills and stock receiving. <a href="/work/erp-cleanup/">Read about the ERP clean-up</a></p>
          </li>
          <li>
            <time>2026 – present</time>
            <h3>Independent developer</h3>
            <p>Built GymFlow end to end and a dealership platform for a client.</p>
          </li>
          <li>
            <time>Graduating March 2027</time>
            <h3>BSc Software Development · KCA University</h3>
            <p>Coursework complete.</p>
          </li>
        </ol>
      </div>
      <div>
        <h2>Tools I use</h2>
        <ul class="skills">{skills.map((s) => <li>{s}</li>)}</ul>
        <p class="small">I have also worked with Java, C# and C++ in coursework.</p>
      </div>
    </div>
  </section>

  <Contact />
</Base>
