---
import Base from '../layouts/Base.astro';
import SystemsMap from '../components/SystemsMap.astro';
import Ledger from '../components/Ledger.astro';
import Socials from '../components/Socials.astro';
import { site } from '../site';
import { getWork } from '../lib/work';

const work = await getWork();

const protocol = [
  { title: 'Map', body: 'Sit with the people who will use it and write down how the work really runs.' },
  { title: 'Build', body: 'Ship a working slice fast, then grow it with your team watching.' },
  { title: 'Harden', body: 'Tests, roles, backups and security checks before any real data goes in.' },
  { title: 'Hand over', body: 'Docs, training and a system your staff can run without me.' },
];
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="status-pill">
          <span class="pulse" aria-hidden="true"></span>Open for projects &amp; roles
        </span>
        <h1>
          I build software for <span class="mark">real operations.</span>
        </h1>
        <p class="lead">
          I'm John, a full-stack developer in Nairobi. Gym front desks, car showrooms, retail ERPs, business messaging —
          I design, build and harden the systems they run on.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/services/">
            Work with me →
          </a>
          <a class="btn" href="/work/">
            Open the dossiers
          </a>
        </div>
        <div class="hero-meta">
          <span>
            <b>{work.length}</b> systems
          </span>
          <span>
            <b>M-Pesa</b> integrated
          </span>
          <span>
            <b>Nairobi</b> · remote OK
          </span>
        </div>
      </div>
      <SystemsMap work={work} />
    </div>
  </section>

  <section class="section ruled" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <span class="label">
          <span class="n">§01</span>The ledger
        </span>
        <h2 id="work-title">Systems in the field.</h2>
        <a class="link-arrow" href="/work/">
          All dossiers →
        </a>
      </div>
      <Ledger work={work} />
    </div>
  </section>

  <section class="section ruled" aria-labelledby="protocol-title">
    <div class="container">
      <div class="section-head">
        <span class="label">
          <span class="n">§02</span>Protocol
        </span>
        <h2 id="protocol-title">How a build runs.</h2>
        <a class="link-arrow" href="/workflow/">
          My workflow →
        </a>
      </div>
      <ol class="protocol">
        {protocol.map((s, i) => (
          <li>
            <span class="step">STEP {String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-title">
    <div class="container">
      <div>
        <span class="label">$ ./start-project</span>
        <h2 id="cta-title">Your business, running on software that fits.</h2>
        <p>Tell me what you're building — a new system, a payment flow, or extra hands on yours.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact/">
          Start a project →
        </a>
        <a class="btn" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </div>
    </div>
  </section>
  <div class="container">
    <Socials />
  </div>
</Base>
