---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds.map((build) => ({ params: { slug: build.id }, props: { build } }));
}

const { build } = Astro.props;
const { Content } = await render(build);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={build.data.title} description={build.data.summary}>
  <article class="section">
    <div class="container content">
      <a class="link-arrow back" href="/builds/">
        ← cd ../builds
      </a>
      <p class="label">
        <time datetime={build.data.date.toISOString()}>{fmt.format(build.data.date)}</time>
      </p>
      <h1 class="page-title">{build.data.title}</h1>
      <p class="lead">{build.data.summary}</p>
      {build.data.video && (
        <p class="page-actions">
          <a class="btn btn-primary" href={build.data.video} target="_blank" rel="noopener noreferrer">
            Watch the video ↗
          </a>
        </p>
      )}
      <Content />
    </div>
  </article>
</Base>
