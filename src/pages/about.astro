---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../site';

const skills = [
  { group: 'Frontend', items: ['TypeScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS', 'HTML & CSS'] },
  { group: 'Backend', items: ['Node.js', 'Fastify', 'Python', 'REST APIs', 'Auth & roles', 'M-Pesa Daraja'] },
  { group: 'Data', items: ['PostgreSQL', 'SQLite', 'Drizzle ORM', 'SQL', 'pandas', 'scikit-learn'] },
  { group: 'Delivery', items: ['Git & GitHub', 'CI/CD', 'Playwright', 'Vitest', 'Docker', 'Claude Code'] },
  { group: 'Business systems', items: ['Odoo ERP', 'Data auditing', 'Excel reporting', 'PowerShell'] },
];

const experience = [
  {
    when: 'Sep – Oct 2026',
    title: 'Industrial attachment — ERP audit & data quality',
    where: 'Brimat Ventures Group',
    href: '/work/brimat-erp/',
  },
  {
    when: '2026',
    title: 'Full-stack developer (client project)',
    where: 'Brimotors Limited',
    href: '/work/brimotors/',
  },
  { when: '2026', title: 'Founder & developer', where: 'Fanovo', href: '/work/fanovo/' },
  { when: '2026', title: 'Founder & developer', where: 'GymFlow', href: '/work/gymflow/' },
  { when: 'Graduating 2027', title: 'BSc Software Development', where: 'KCA University', href: '' },
];
---

<Base title="About" description="About John Kuria, a full-stack software developer in Nairobi.">
  <section class="page-head">
    <div class="container split">
      <figure class="plate">
        <Image
          class="portrait"
          src={portrait}
          alt="John Kuria"
          widths={[400, 640, 800]}
          sizes="(max-width: 860px) 100vw, 480px"
          loading="eager"
        />
        <figcaption>
          <span>{site.legalName}</span>
          <span>{site.location}</span>
        </figcaption>
      </figure>
      <div>
        <span class="label">
          <span class="n">~/</span>about
        </span>
        <h1 class="page-title">Hi, I'm John.</h1>
        <div class="content">
          <p class="lead">I build software that businesses use every day — not demos that sit in a folder.</p>
          <p>
            My work runs from the screen a receptionist taps to the database behind it: interfaces, APIs, payments,
            access control and the tests that keep it honest. I like problems where getting it right saves someone real
            time or money.
          </p>
          <p>
            I'm finishing a BSc in Software Development at KCA University (March 2027). I take freelance projects,
            collaborate with other builders, and I'm open to developer roles in Nairobi or remote.
          </p>
        </div>
        <Socials />
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="cv-title">
    <div class="container split">
      <div>
        <span class="label">
          <span class="n">§01</span>Record
        </span>
        <h2 id="cv-title" class="page-title">
          Where I've worked.
        </h2>
      </div>
      <ol class="cv">
        {experience.map((e) => (
          <li>
            <span class="when">{e.when}</span>
            <span>
              {e.href ? <a href={e.href}>{e.title}</a> : e.title}
              <span class="where"> · {e.where}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="kit-title">
    <div class="container">
      <div class="section-head">
        <span class="label">
          <span class="n">§02</span>Toolkit
        </span>
        <h2 id="kit-title">What I work with.</h2>
      </div>
      <div class="toolkit">
        {skills.map((s) => (
          <div>
            <h3>{s.group}</h3>
            <ul class="tags">
              {s.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
