---
import { getWork } from '../../lib/work';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = await getWork();
---

<Base title="Work" description="Products, client systems and engagements by John Kuria — each written up as a dossier.">
  <section class="page-head">
    <div class="container">
      <span class="label">
        <span class="n">~/</span>work
      </span>
      <h1 class="page-title">The dossiers.</h1>
      <p class="lead">
        Every system I've built, filed the same way: the brief, the architecture, the decisions I made and where it
        stands today.
      </p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container dossier-grid">
      {work.map((project, i) => (
        <WorkCard project={project} index={i} eager={i < 2} />
      ))}
    </div>
  </section>
</Base>
