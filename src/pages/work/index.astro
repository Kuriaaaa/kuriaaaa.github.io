---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { title: 'Professional work', kinds: ['experience', 'product', 'client'] },
  { title: 'Academic', kinds: ['academic'] },
  { title: 'Research & experiments', kinds: ['research'] },
].map((g) => ({ ...g, items: all.filter((e) => g.kinds.includes(e.data.kind)) }));
const starts = groups.map((_, i) => groups.slice(0, i).reduce((n, g) => n + g.items.length, 0));
---

<Base title="Work" description="Every project by Chege John Brian Kuria: products, client builds, coursework and research.">
  <section class="page-head">
    <div class="container">
      <span class="label"><span class="n">~/</span>work</span>
      <h1 class="page-title">The dossiers.</h1>
      <p class="lead">Every project, filed the same way: what it is, where it stands and how it was built.</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      {
        groups.map((g, i) => (
          <section class="group">
            <h2>{g.title}</h2>
            <Ledger work={g.items} start={starts[i]} />
          </section>
        ))
      }
    </div>
  </section>
</Base>
