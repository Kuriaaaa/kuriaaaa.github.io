---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getWork } from '../../lib/work';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: work[(i + 1) % work.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.summary}>
  <article class={`t-${d.theme}`}>
    <header class="case-hero container">
      <a class="link-arrow back" href="/work/">
        ← cd ../work
      </a>
      <span class="label">
        <span class="n">{d.year}</span>// {d.kind.toLowerCase()}
      </span>
      <h1>
        {d.title}
        <span class="dot">.</span>
      </h1>
      <p class="lead">{d.summary}</p>
      {d.links.length > 0 && (
        <div class="btn-row case-links">
          {d.links.map((l, i) => (
            <a class:list={['btn', { 'btn-primary': i === 0 }]} href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          ))}
        </div>
      )}
      <dl class="facts">
        <div>
          <dt>Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{d.status}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{d.stack.join(', ')}</dd>
        </div>
      </dl>
    </header>

    {d.cover && (
      <div class="container">
        <Image
          class="case-cover"
          src={d.cover}
          alt={d.coverAlt ?? ''}
          widths={[800, 1280, 1920]}
          sizes="(max-width: 1100px) 100vw, 1080px"
          loading="eager"
        />
      </div>
    )}

    <div class="container section-tight">
      <div class="content">
        <Content />
      </div>
    </div>

    {d.gallery.length > 1 && (
      <section class="container section-tight" aria-label="Screens">
        <div class="gallery">
          {d.gallery.slice(1).map((g) => (
            <figure>
              <Image src={g.src} alt={g.alt} widths={[640, 1080]} sizes="(max-width: 820px) 100vw, 530px" />
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <nav class="container section-tight next-project" aria-label="Next project">
      <span class="label">
        <span class="n">→</span>next project
      </span>
      <a href={`/work/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>
