---
import Base from '../layouts/Base.astro';

const loop = [
  { title: 'Spec', body: 'Write down what "done" means: users, rules, edge cases, the numbers that matter.' },
  { title: 'Plan', body: 'Map the data, the roles and the risks before a line of code changes.' },
  { title: 'Build', body: 'Small, reviewable changes — features, migrations and the tests for them, together.' },
  { title: 'Verify', body: 'Type checks and automated tests run locally, then again in CI, plus checks on real phones.' },
  { title: 'Ship', body: 'Every change is reviewed, CI deploys, and monitoring watches what went live.' },
];

const practices = [
  {
    name: 'Version control & CI',
    body: 'Every change lives in Git. Builds and tests run automatically before anything is deployed, so a broken change never reaches users.',
  },
  {
    name: 'Monitoring',
    body: 'The systems I run are watched for uptime, SSL expiry and errors, with alerts when something breaks — tracked in DevControl.',
    href: '/work/devcontrol/',
  },
  {
    name: 'Handover notes in the repo',
    body: "Each project keeps plain notes — how to run it, what's done, what's next — so anyone can pick up where work stopped.",
  },
];

const principles = [
  {
    title: 'Tests decide.',
    body: 'Code ships when it passes the checks and review, not because it looks right.',
  },
  {
    title: 'Secrets stay out.',
    body: 'Client data, keys and passwords stay in the systems they belong to. Demos run on fictional data.',
  },
  {
    title: 'Small changes, always.',
    body: 'Changes stay small enough to read in one sitting, so nothing slips past review.',
  },
];
---

<Base
  title="Process"
  description="How Chege John Brian Kuria builds: a five-step loop on every project, with tests, review and monitoring deciding what ships."
>
  <section class="page-head">
    <div class="container split">
      <div>
        <span class="label">
          <span class="n">~/</span>process
        </span>
        <h1 class="page-title">Small-team speed. Careful by default.</h1>
      </div>
      <div>
        <p class="lead">
          How I take a build from the first conversation to a system people rely on. The same loop runs on every
          project, big or small.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="loop-title">
    <div class="container">
      <div class="section-head">
        <span class="label">
          <span class="n">§01</span>The loop
        </span>
        <h2 id="loop-title">Five steps, every change.</h2>
      </div>
      <ol class="protocol five">
        {loop.map((s, i) => (
          <li>
            <span class="step">STEP {String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="container split">
      <div>
        <span class="label">
          <span class="n">§02</span>Practices
        </span>
        <h2 id="tools-title" class="page-title">What every project gets.</h2>
        <pre
          class="terminal"
          aria-label="Example release checks"
        ><span class="c"># checks before this site ships</span>
<span class="p">$</span> npm run build
  ✓ static     every page, zero JavaScript
  ✓ csp        strict, self-hosted fonts only</pre>
      </div>
      <ul class="cv">
        {practices.map((t) => (
          <li>
            <span class="when">{t.name}</span>
            <span>
              {t.body}
              {t.href && (
                <>
                  {' '}
                  <a href={t.href}>See DevControl →</a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <span class="label">
          <span class="n">§03</span>Rules
        </span>
        <h2 id="principles-title">What doesn't bend.</h2>
      </div>
      <ul class="principles">
        {principles.map((p) => (
          <li>
            <b>{p.title}</b>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-title">
    <div class="container">
      <div>
        <span class="label">$ ./collaborate</span>
        <h2 id="cta-title">Want this loop on your build?</h2>
        <p>I join projects as a build partner — features, tests, reviews or a full delivery.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="/services/">
          See services →
        </a>
        <a class="btn" href="/#contact">
          Contact
        </a>
      </div>
    </div>
  </section>
</Base>
