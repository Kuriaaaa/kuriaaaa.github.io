---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container">
      <span class="label">
        <span class="n">404</span>// not found
      </span>
      <h1 class="page-title">This page doesn't exist.</h1>
      <p class="lead">It may have moved when the site was rebuilt.</p>
      <div class="btn-row page-actions">
        <a class="btn btn-primary" href="/">
          Go home
        </a>
        <a class="btn" href="/work/">
          See my work
        </a>
      </div>
    </div>
  </section>
</Base>
