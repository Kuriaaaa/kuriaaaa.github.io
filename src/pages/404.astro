---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="page-head">
    <div class="container">
      <span class="label"><span class="n">404</span>Not found</span>
      <h1 class="page-title">This page doesn't exist.</h1>
      <p class="lead">It may have moved when the site was rebuilt.</p>
      <div class="btn-row page-actions">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn" href="/work/">All projects</a>
      </div>
    </div>
  </section>
</Base>
