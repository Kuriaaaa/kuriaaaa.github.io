---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" noindex>
  <section class="section">
    <div class="container">
      <span class="label">
        <span class="n">200</span>// message sent
      </span>
      <h1 class="page-title">Thank you.</h1>
      <p class="lead">Your message is on its way. I'll reply to the email address you gave.</p>
      <div class="btn-row page-actions">
        <a class="btn btn-primary" href="/work/">
          Back to my work
        </a>
      </div>
    </div>
  </section>
</Base>
