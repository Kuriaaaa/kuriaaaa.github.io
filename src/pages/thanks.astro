---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" noindex>
  <section class="page-head">
    <div class="container">
      <span class="label"><span class="n">200</span>Message sent</span>
      <h1 class="page-title">Thank you.</h1>
      <p class="lead">I'll reply within a working day. For anything urgent, WhatsApp is fastest.</p>
      <div class="btn-row page-actions">
        <a class="btn btn-primary" href="/">Back to the portfolio</a>
      </div>
    </div>
  </section>
</Base>
