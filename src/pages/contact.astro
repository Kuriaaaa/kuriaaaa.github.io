---
import Base from '../layouts/Base.astro';
import { site, socials } from '../site';

const thanks = new URL('/thanks/', Astro.site).href;
const linkedin = socials.find((s) => s.id === 'linkedin');
---

<Base title="Contact" description="Hire or collaborate with John Kuria — projects, roles and build partnerships.">
  <section class="page-head">
    <div class="container split">
      <div>
        <span class="label">
          <span class="n">~/</span>contact
        </span>
        <h1 class="page-title">Let's build.</h1>
        <p class="lead">
          A project, a role, or a build you need help finishing — tell me a little about it and I'll get back to you.
        </p>
        <ul class="direct">
          <li>
            <span class="label">Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="label">WhatsApp</span>
            <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">
              Message me ↗
            </a>
          </li>
          {linkedin && (
            <li>
              <span class="label">LinkedIn</span>
              <a href={linkedin.url} target="_blank" rel="noopener noreferrer">
                Connect ↗
              </a>
            </li>
          )}
          <li>
            <span class="label">Based</span>
            <span>{site.location} · remote worldwide</span>
          </li>
        </ul>
      </div>
      <form class="form" action={`https://formsubmit.co/${site.email}`} method="post">
        <input type="hidden" name="_subject" value="New enquiry from johnkuria portfolio" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={thanks} />
        <label class="honey" aria-hidden="true">
          Leave empty
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </label>
        <label>
          Name
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          What's it about?
          <select name="topic" required>
            <option value="" selected disabled>
              Choose one
            </option>
            <option>Build a system for my business</option>
            <option>M-Pesa or payments integration</option>
            <option>Help on an existing build</option>
            <option>ERP or data clean-up</option>
            <option>Job or internship</option>
            <option>Something else</option>
          </select>
        </label>
        <label>
          Message
          <textarea
            name="message"
            placeholder="What does the business do, what's not working, and when do you need it?"
            required
          ></textarea>
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" value="yes" required />
          <span>
            I agree to my message being sent through FormSubmit as described in the{' '}
            <a href="/privacy/">privacy notice</a>.
          </span>
        </label>
        <div>
          <button class="btn btn-primary" type="submit">
            Send message →
          </button>
        </div>
      </form>
    </div>
  </section>
</Base>
