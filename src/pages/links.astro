---
// Link-in-bio page for TikTok, Instagram, X and YouTube profiles.
import { Image } from 'astro:assets';
import { getBuilds } from '../lib/work';
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../site';

const latest = (await getBuilds())[0];
---

<Base title="Links" description={`${site.name} — all links in one place.`} bare>
  <div class="links-page">
    <Image class="avatar" src={portrait} alt={site.name} width={224} height={224} loading="eager" />
    <h1>{site.name}</h1>
    <p class="muted">
      {site.role} · {site.location}
    </p>
    <span class="status-pill">
      <span class="pulse" aria-hidden="true"></span>Open for projects
    </span>
    <div class="links-list">
      {latest && (
        <a class="btn btn-primary" href={`/builds/${latest.id}/`}>
          Latest build: {latest.data.title}
        </a>
      )}
      <a class:list={['btn', { 'btn-primary': !latest }]} href="/services/">
        Hire me — services
      </a>
      <a class="btn" href="/">
        Portfolio
      </a>
      <a class="btn" href="/work/gymflow/">
        GymFlow — gym management system
      </a>
      <a class="btn" href="/work/brimotors/">
        Brimotors — car showroom platform
      </a>
      <a class="btn" href="/work/fanovo/">
        Fanovo — business messaging
      </a>
      <a class="btn" href="/contact/">
        Contact
      </a>
    </div>
    <Socials />
  </div>
</Base>
