---
import '../styles/global.css';
import { site, socials, nav } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bare?: boolean;
}
const { title, description = site.description, image = '/og.jpg', noindex = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.legalName,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'KCA University' },
  sameAs: socials.filter((s) => s.id !== 'whatsapp').map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Builds`} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {!bare && (
      <header class="site-header">
        <div class="container">
          <a class="brand" href="/" aria-label={`${site.name} — home`}>
            <span class="mark" aria-hidden="true">
              JK
            </span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-handle">@{site.handle}</span>
          </a>
          <nav class="nav" aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    {!bare && (
      <footer class="site-footer">
        <div class="container">
          <span>
            © {new Date().getFullYear()} {site.name} <span class="handle">· @{site.handle}</span>
          </span>
          <nav aria-label="Footer">
            {socials
              .filter((s) => s.id !== 'whatsapp')
              .map((s) => (
                <a href={s.url} target="_blank" rel="noopener noreferrer me">
                  {s.label}
                </a>
              ))}
            <a href="/links/">Links</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
      </footer>
    )}
  </body>
</html>
