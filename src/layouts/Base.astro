---
import '../styles/global.css';
import { site, socials, nav } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bare?: boolean;
}
const { title, description = site.description, image = '/og.jpg', noindex = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const elsewhere = socials.filter((s) => s.id !== 'whatsapp');

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.legalName,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'KCA University' },
  knowsAbout: ['Web applications', 'APIs', 'PostgreSQL', 'M-Pesa Daraja', 'Odoo ERP', 'TypeScript', 'Python'],
  sameAs: elsewhere.map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11110f" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Builds`} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {!bare && (
      <header class="site-header">
        <div class="container">
          <a class="brand" href="/" aria-label={`${site.name} — home`}>
            <span class="brand-mark" aria-hidden="true">
              JK
            </span>
            <span class="brand-name">{site.name}</span>
            <span class="brand-handle">@{site.handle}</span>
          </a>
          <nav class="nav nav-desktop" aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            <a class="nav-cta" href="/contact/">
              Hire me
            </a>
          </nav>
          <details class="nav-toggle">
            <summary>Menu</summary>
            <nav class="nav" aria-label="Main (mobile)">
              {nav.map((item) => (
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
              <a class="nav-cta" href="/contact/">
                Hire me
              </a>
            </nav>
          </details>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    {!bare && (
      <footer class="site-footer">
        <div class="container">
          <div class="footer-grid">
            <div>
              <span class="label">
                <span class="n">§</span>end of file
              </span>
              <h2>Got a system to build?</h2>
              <p class="muted">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
            <div>
              <span class="label">Site</span>
              <ul>
                <li>
                  <a href="/work/">Work</a>
                </li>
                <li>
                  <a href="/services/">Services</a>
                </li>
                <li>
                  <a href="/workflow/">Workflow</a>
                </li>
                <li>
                  <a href="/builds/">Build log</a>
                </li>
                <li>
                  <a href="/contact/">Contact</a>
                </li>
              </ul>
            </div>
            <div>
              <span class="label">Elsewhere</span>
              <ul>
                {elsewhere.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener noreferrer me">
                      {s.label} ↗
                    </a>
                  </li>
                ))}
                <li>
                  <a href="/links/">All links</a>
                </li>
                <li>
                  <a href="/privacy/">Privacy</a>
                </li>
              </ul>
            </div>
          </div>
          <div class="footer-base">
            <span>
              © {new Date().getFullYear()} {site.legalName}
            </span>
            <span>Built in Nairobi · Astro · no trackers</span>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
