---
// A project as a dossier folder: tab, plate, summary and stage.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Stage from './Stage.astro';

interface Props {
  project: CollectionEntry<'work'>;
  index: number;
  eager?: boolean;
}
const { project, index, eager = false } = Astro.props;
const { title, summary, kind, year, stack, cover, coverAlt, highlight, stage, source } = project.data;
---

<a class="dossier-card" href={`/work/${project.id}/`}>
  <div class="tab">
    <span>
      Dossier {String(index + 1).padStart(2, '0')} · {kind}
    </span>
    <span>{year}</span>
  </div>
  {cover ? (
    <div class="media">
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[640, 960, 1280]}
        sizes="(max-width: 820px) 100vw, 580px"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
  ) : (
    <div class="media placeholder" aria-hidden="true">
      <strong>{highlight?.value ?? kind}</strong>
      {highlight && <small>{highlight.label}</small>}
    </div>
  )}
  <div class="body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <ul class="tags">
      {stack.slice(0, 4).map((t) => (
        <li>{t}</li>
      ))}
    </ul>
    <div class="foot">
      <Stage stage={stage} />
      <span class="label">{source === 'public' ? 'Source public' : 'Source private'} · Open →</span>
    </div>
  </div>
</a>
