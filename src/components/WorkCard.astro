---
import type { CollectionEntry } from 'astro:content';
import { kindLabel } from '../site';

interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const { title, summary, kind, status, cover, coverAlt, stack } = entry.data;
const initials = title.split(' ').slice(0, 2).map((w) => w[0]).join('');
---
<article class="card">
  {cover ? (
    <div class="card-cover"><img src={cover} alt={coverAlt ?? ''} width="1425" height="990" loading="lazy" /></div>
  ) : (
    <div class="card-cover placeholder" aria-hidden="true">{initials}</div>
  )}
  <div class="card-body">
    <div class="meta"><span class={`badge kind-${kind}`}>{kindLabel[kind]}</span><span>{status}</span></div>
    <h3><a href={`/work/${entry.id}/`}>{title}</a></h3>
    <p>{summary}</p>
    <ul class="tags" aria-label="Technology">{stack.slice(0, 4).map((s) => <li>{s}</li>)}</ul>
    <span class="more" aria-hidden="true">Read the case study →</span>
  </div>
</article>
