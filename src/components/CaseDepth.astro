---
// The structured "depth" sections of a case study: architecture, key decisions and timeline.
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'work'>['data'];
}
const { architecture, decisions, timeline } = Astro.props.data;
---

{architecture && (
  <section class="container section-tight" aria-labelledby="arch-title">
    <span class="label">
      <span class="n">#</span>architecture
    </span>
    <h2 id="arch-title" class="depth-title">
      How it fits together
    </h2>
    <div class="arch">
      {architecture.layers.map((layer, i) => (
        <>
          {i > 0 && <div class="arch-arrow" aria-hidden="true" />}
          <div class="arch-layer">
            <span class="arch-name">{layer.name}</span>
            <ul class="arch-items">
              {layer.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </>
      ))}
    </div>
    <p class="arch-caption">{architecture.caption}</p>
  </section>
)}

{decisions.length > 0 && (
  <section class="container section-tight" aria-labelledby="decisions-title">
    <span class="label">
      <span class="n">#</span>decisions
    </span>
    <h2 id="decisions-title" class="depth-title">
      Key decisions
    </h2>
    <ol class="decisions">
      {decisions.map((d, i) => (
        <li>
          <span class="decision-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </li>
      ))}
    </ol>
  </section>
)}

{timeline.length > 0 && (
  <section class="container section-tight" aria-labelledby="timeline-title">
    <span class="label">
      <span class="n">#</span>timeline
    </span>
    <h2 id="timeline-title" class="depth-title">
      How it unfolded
    </h2>
    <ol class="timeline">
      {timeline.map((t) => (
        <li class:list={{ pending: !t.done }}>
          <span class="when">{t.when}</span>
          <span class="what">{t.title}</span>
          <span class="state">{t.done ? 'done' : 'next'}</span>
        </li>
      ))}
    </ol>
  </section>
)}
