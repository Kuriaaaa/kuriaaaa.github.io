---
import { site, nav } from '../site';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="brand-mark" aria-hidden="true">CK</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="nav nav-desktop" aria-label="Main">
      {nav.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a class="nav-cta" href="/#contact">Hire me</a>
    </nav>
    <details class="nav-toggle">
      <summary>Menu</summary>
      <nav class="nav" aria-label="Main (mobile)">
        {nav.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
        <a class="nav-cta" href="/#contact">Hire me</a>
      </nav>
    </details>
  </div>
</header>
