---
import { site } from '../site';
const thanks = new URL('/thanks/', Astro.site).href;
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="contact-title">Have a role or a project? <em>Let's talk.</em></h2>
      <p>WhatsApp is usually the fastest way to reach me. I reply to email within a working day.</p>
    </div>
    <div class="contact-grid">
      <ul class="contact-links">
        <li><a href={site.whatsapp} rel="noopener">WhatsApp <small>+254 717 246 699</small></a></li>
        <li><a href={site.linkedin} rel="noopener">LinkedIn <small>Connect</small></a></li>
        <li><a href={site.github} rel="noopener">GitHub <small>See the code</small></a></li>
      </ul>
      <form class="enquiry" action={site.formAction} method="post">
        <input type="hidden" name="_subject" value="Portfolio enquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={thanks} />
        <label class="honey" aria-hidden="true">Leave empty<input name="_honey" tabindex="-1" autocomplete="off" /></label>
        <div class="row">
          <label>Name<input name="name" autocomplete="name" required /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <label>What's it about?
          <select name="enquiry_type" required>
            <option value="">Choose one</option>
            <option>Job or internship</option>
            <option>Freelance project</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="4" required></textarea></label>
        <label class="consent"><input type="checkbox" name="privacy_ok" value="yes" required />
          <span>I agree my message is sent through FormSubmit so I can reply. <a href="/privacy/">Privacy notice</a></span></label>
        <button class="button primary" type="submit">Send message →</button>
      </form>
    </div>
  </div>
</section>
