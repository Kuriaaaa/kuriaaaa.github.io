---
// The project index as a ledger: one ruled row per system.
import type { CollectionEntry } from 'astro:content';
import Stage from './Stage.astro';

interface Props {
  work: CollectionEntry<'work'>[];
}
const { work } = Astro.props;
---

<ol class="ledger">
  {work.map((p, i) => {
    const metric = p.data.highlight ?? p.data.metrics[0];
    return (
      <li>
        <a href={`/work/${p.id}/`}>
          <span class="no">{String(i + 1).padStart(2, '0')}</span>
          <span class="title">{p.data.title}</span>
          <span class="sector">{p.data.sector}</span>
          <Stage stage={p.data.stage} />
          <span class="metric">
            {metric && (
              <>
                <b>{metric.value}</b>
                <span>{metric.label}</span>
              </>
            )}
          </span>
          <span class="go" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    );
  })}
</ol>
