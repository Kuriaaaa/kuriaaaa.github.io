---
// Projects as a ledger: one ruled row per system.
import type { CollectionEntry } from 'astro:content';
import Stage from './Stage.astro';

interface Props {
  work: CollectionEntry<'work'>[];
  start?: number;
}
const { work, start = 0 } = Astro.props;
---

<ol class="ledger">
  {
    work.map((p, i) => (
      <li>
        <a href={`/work/${p.id}/`}>
          <span class="no">{String(start + i + 1).padStart(2, '0')}</span>
          <span class="title">{p.data.title}</span>
          <span class="sector">{p.data.sector}</span>
          <Stage stage={p.data.stage} />
          <span class="metric stack">{p.data.stack.slice(0, 3).join(' · ')}</span>
          <span class="go" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>
